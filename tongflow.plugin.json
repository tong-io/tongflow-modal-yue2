{
    "plugin": {
        "name": "YuE2",
        "description": "Lyrics-to-song generation with editable score planning, plus zero-shot covers via SheetSage2 transcription. Weights: CC BY-NC 4.0 (non-commercial).",
        "icon": "/plugins/tongflow-modal-yue2.svg"
    },
    "env": [
        {
            "key": "MODAL_TOKEN_ID",
            "required": true,
            "description": "Modal token id",
            "url": "https://modal.com/settings/tokens"
        },
        {
            "key": "MODAL_TOKEN_SECRET",
            "required": true,
            "description": "Modal token secret (paired with MODAL_TOKEN_ID)"
        },
        {
            "key": "TONGFLOW_MODAL_CALL_TIMEOUT_S",
            "default": "2400",
            "description": "Max seconds to wait for a Modal call"
        }
    ]
}
